# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (see ../DEPLOY.md)
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/portfolioDB?retryWrites=true&w=majority
PORT=5000

# Frontend URL(s) allowed by CORS, comma-separated, no trailing slash.
# localhost is always allowed when NODE_ENV is not "production".
CLIENT_URL=http://localhost:5173

# Optional: email alert for each contact message (any SMTP provider)
# Gmail: smtp.gmail.com, port 587, SMTP_PASS = a Google App Password
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (auto-detected from the port if left empty)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown on the alert (defaults to SMTP_USER)
MAIL_FROM=
# Where alerts go (defaults to SMTP_USER)
MAIL_TO=
